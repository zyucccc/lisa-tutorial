class TwoVarPerLinearInequality {

    basic() {
        def x = 10;
        def y = 5;

        //instantiate des inequality
        if (x <= y + 5) {  //  x ≤ y + 5
            x = y + 2;     //  x = y + 2， = x ≤ y + 2 = y ≤ x - 2
        }

        def z = x - y;     //  z = x - y

        if (z > 0) {       //  z > 0
            y = y + z;     //  y = y + z
        }

        return z;
    }

}