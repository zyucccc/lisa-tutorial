class product {
    test() {
        def x = 10;    // - ExtendedSign: POS
        def y = 0;     // - ExtendedSign: ZERO
        def z = -5;    //  - ExtendedSign: NEG

        // extendedSignDomain
        if (y == 0) {  // ==0
            x = x + 1; // x > 0
        }

        if (x > 0) {   // >0
            y = z;     // y < 0  z < 0
                       // : y < 0, z < 0, y = z
        }

        // TwoVarPerLinearInequality
        if (x + y > 1) {  // inequality
            z = x + 2;
        }

    }
}