    conditionals() {
        def i = 0;       // i ZERO
        def j = 5;       // j POS
        def k = -3;      // k NEG

        if(i > 0) {      // false (ZERO > POS)
            i = 10;
        } else {
            i = -10;     // i = NEG
        }

        if(j > 0) {      // true  (POS > ZERO)
            j = j * 2;   // j == POS
        }

        if(k < 0) {      // true (NEG < ZERO)
            k = k - 5;   // k == NEG
        }

        def x = 0;       // x ZERO
        if(x == 0) {     // true
            x = 1;       // x == POS
        }

        def y = x * k;   // POS * NEG = NEG
    }
